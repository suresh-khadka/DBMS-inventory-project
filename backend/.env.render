# ============================================
# Render Deployment Configuration Template
# ============================================
# Copy this file and set these values in your Render environment

# Django Settings
DEBUG=False
SECRET_KEY=your-generated-secret-key-here
ALLOWED_HOSTS=*.onrender.com,localhost,127.0.0.1

# Database (PostgreSQL on Render)
# This is auto-populated by Render from the PostgreSQL service
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# CORS Settings (for production)
# Set this to your frontend domain
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com

# Django Settings Module
DJANGO_SETTINGS_MODULE=inventory_system.settings

# Server Configuration
WEB_CONCURRENCY=4
PYTHON_VERSION=3.10

# Logging Level
DJANGO_LOG_LEVEL=INFO
