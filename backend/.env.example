# ============================================
# Django Settings
# ============================================
DEBUG=True
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# ============================================
# Database Settings
# ============================================
# Option 1: For local development (MySQL)
DB_NAME=inventory_db
DB_USER=root
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=3306

# Option 2: For Render production (PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Leave this empty for local development
DATABASE_URL=

# ============================================
# CORS Settings
# ============================================
CORS_ALLOW_ALL_ORIGINS=True

# For production, specify allowed origins:
# CORS_ALLOWED_ORIGINS=https://your-frontend.com,https://your-domain.com

# ============================================
# Additional Settings
# ============================================
DJANGO_SETTINGS_MODULE=inventory_system.settings
PYTHON_VERSION=3.10
WEB_CONCURRENCY=4

